# Order-only phony target for llama-results

build cmake_object_order_depends_target_llama-results: phony || cmake_object_order_depends_target_ggml cmake_object_order_depends_target_ggml-base cmake_object_order_depends_target_llama cmake_object_order_depends_target_llama-common cmake_object_order_depends_target_llama-common-base

build build-llama/tools/results/CMakeFiles/llama-results.dir/results.cpp.o: CXX_COMPILER__llama-results_unscanned_Release C$:/Users/ASUS/Desktop/PocketForgeAI/third_party/llama.cpp/tools/results/results.cpp || cmake_object_order_depends_target_llama-results
  DEFINES = -DGGML_BACKEND_DL -DGGML_SHARED -DLLAMA_SHARED
  DEP_FILE = build-llama\tools\results\CMakeFiles\llama-results.dir\results.cpp.o.d
  FLAGS = -g -DANDROID -fdata-sections -ffunction-sections -funwind-tables -fstack-protector-strong -no-canonical-prefixes -D_FORTIFY_SOURCE=2 -Wformat -Werror=format-security  -static-openmp -O3 -DNDEBUG  -std=gnu++17 -fPIE -Xclang -fno-pch-timestamp -Wmissing-declarations -Wmissing-noreturn -Wall -Wextra -Wpedantic -Wcast-qual -Wno-unused-function -Wunreachable-code-break -Wunreachable-code-return -Wmissing-prototypes -Wextra-semi -pthread
  INCLUDES = -IC:/Users/ASUS/Desktop/PocketForgeAI/third_party/llama.cpp/common/. -IC:/Users/ASUS/Desktop/PocketForgeAI/third_party/llama.cpp/vendor/nlohmann/.. -IC:/Users/ASUS/Desktop/PocketForgeAI/third_party/llama.cpp/vendor/sheredom/.. -IC:/Users/ASUS/Desktop/PocketForgeAI/third_party/llama.cpp/src/../include -IC:/Users/ASUS/Desktop/PocketForgeAI/third_party/llama.cpp/ggml/src/../include
  OBJECT_DIR = build-llama\tools\results\CMakeFiles\llama-results.dir
  OBJECT_FILE_DIR = build-llama\tools\results\CMakeFiles\llama-results.dir


# =============================================================================
# Link build statements for EXECUTABLE target llama-results


#############################################
# Link the executable bin\llama-results

build bin/llama-results: CXX_EXECUTABLE_LINKER__llama-results_Release build-llama/tools/results/CMakeFiles/llama-results.dir/results.cpp.o | bin/libllama-common.so bin/libllama.so bin/libggml.so bin/libggml-base.so build-llama/common/libllama-common-base.a || bin/libggml-base.so bin/libggml.so bin/libllama-common.so bin/libllama.so build-llama/common/libllama-common-base.a
  DEP_FILE = build-llama\tools\results\CMakeFiles\llama-results.dir\link.d
  FLAGS = -g -DANDROID -fdata-sections -ffunction-sections -funwind-tables -fstack-protector-strong -no-canonical-prefixes -D_FORTIFY_SOURCE=2 -Wformat -Werror=format-security  -static-openmp -O3 -DNDEBUG
  LINK_FLAGS = -static-libstdc++ -Wl,--build-id=sha1 -Wl,--no-rosegment -Wl,--no-undefined-version -Wl,--fatal-warnings -Wl,--no-undefined -Qunused-arguments   -Wl,--gc-sections     -Xlinker --dependency-file=build-llama\tools\results\CMakeFiles\llama-results.dir\link.d
  LINK_LIBRARIES = bin/libllama-common.so  bin/libllama.so  -pthread  bin/libggml.so  bin/libggml-base.so  build-llama/common/libllama-common-base.a  -pthread  -latomic -lm
  OBJECT_DIR = build-llama\tools\results\CMakeFiles\llama-results.dir
  POST_BUILD = cd .
  PRE_LINK = cd .
  TARGET_FILE = bin\llama-results
  TARGET_PDB = llama-results.dbg


