<Window x:Class="PocketForgeDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PocketForge Desktop" Width="960" Height="720"
        MinWidth="700" MinHeight="520"
        Background="{DynamicResource BgBrush}"
        Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FieldStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
    </Window.Resources>
    <DockPanel LastChildFill="True">

        <!-- Connection bar -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,10">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Host" VerticalAlignment="Center" Foreground="{DynamicResource SubBrush}" Margin="0,0,6,0"/>
                    <TextBox x:Name="HostBox" Grid.Column="1" VerticalContentAlignment="Center" Style="{StaticResource FieldStyle}"/>
                    <TextBlock Text="Port" Grid.Column="2" VerticalAlignment="Center" Foreground="{DynamicResource SubBrush}" Margin="10,0,6,0"/>
                    <TextBox x:Name="PortBox" Grid.Column="3" VerticalContentAlignment="Center" Style="{StaticResource FieldStyle}"/>
                    <Button x:Name="ConnectButton" Content="Connect" Grid.Column="4" Click="Connect_Click"
                            Style="{StaticResource ButtonStyle}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <Button x:Name="DisconnectButton" Content="Disconnect" Grid.Column="5" Click="Disconnect_Click"
                            Style="{StaticResource ButtonStyle}" Margin="8,0,0,0" IsEnabled="False" VerticalAlignment="Center"/>
                    <Ellipse x:Name="StatusDot" Grid.Column="7" Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Grid.Column="8" VerticalAlignment="Center"
                               Text="Disconnected" Foreground="{DynamicResource TextBrush}"/>
                </Grid>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ModelInfoText" Text="Not connected." Foreground="{DynamicResource SubBrush}" TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="ThemeButton" Grid.Column="1" Content="Theme: Auto" Click="Theme_Click"
                            Style="{StaticResource ButtonStyle}" Margin="0,0,8,0" ToolTip="Cycle theme: Auto (follows Windows) -> Dark -> Light"/>
                    <Button x:Name="RefreshButton" Grid.Column="2" Content="Refresh status" Click="RefreshStatus_Click"
                            Style="{StaticResource ButtonStyle}"/>
                </Grid>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PfApiText" Text="pf_api: unknown" Foreground="{DynamicResource SubBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ErrorLine" Grid.Column="2" HorizontalAlignment="Right" Text=""
                               Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" MaxWidth="560" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="USB: adb reverse tcp:8751 tcp:8751"
                               Foreground="{DynamicResource SubBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Agent activity panel (bottom-most) -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,6">
            <Expander x:Name="AgentPanel">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="AgentModeCheckBox" Content="Agent mode" Checked="AgentMode_Changed" Unchecked="AgentMode_Changed"/>
                        <CheckBox x:Name="TurboCheckBox" Content="Turbo" Margin="16,0,0,0" VerticalAlignment="Center"
                                  Checked="Turbo_Changed" Unchecked="Turbo_Changed"
                                  ToolTip="Distributed speculative decoding: a local draft model proposes tokens, the phone verifies them. Falls back to normal mode when unavailable."/>
                        <TextBlock x:Name="TurboStatusText" Text="Turbo: off" Foreground="{DynamicResource SubBrush}"
                                   Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="   tool calls and results appear below" Foreground="{DynamicResource SubBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Expander.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="LoopList" ItemsSource="{Binding LoopItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,1" FontFamily="Consolas" FontSize="12"
                                               Text="{Binding Display}" Foreground="{DynamicResource TextBrush}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Button Grid.Row="1" Content="Clear" HorizontalAlignment="Right" Margin="0,6,0,0"
                            Style="{StaticResource ButtonStyle}" Click="ClearLoop_Click"/>
                </Grid>
            </Expander>
        </Border>

        <!-- Input bar -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="InputBox" Grid.Column="0" AcceptsReturn="True" TextWrapping="Wrap"
                         Height="64" VerticalScrollBarVisibility="Auto"
                         PreviewKeyDown="InputBox_PreviewKeyDown"
                         Style="{StaticResource FieldStyle}"/>
                <Button x:Name="NewSessionButton" Grid.Column="1" Content="New session" Click="NewSession_Click"
                        Style="{StaticResource ButtonStyle}" Margin="10,0,0,0" VerticalAlignment="Top"/>
                <Button x:Name="StopButton" Grid.Column="2" Content="Stop" Click="Stop_Click"
                        Style="{StaticResource ButtonStyle}" Margin="8,0,0,0" IsEnabled="False" VerticalAlignment="Top"/>
                <Button x:Name="SendButton" Grid.Column="3" Content="Send" Click="Send_Click"
                        Style="{StaticResource ButtonStyle}" Margin="8,0,0,0" VerticalAlignment="Top"
                        FontSize="14" FontWeight="SemiBold"/>
            </Grid>
        </Border>

        <!-- Chat -->
        <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" Padding="12,10">
            <ItemsControl x:Name="MessagesList" ItemsSource="{Binding Messages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3">
                            <Border Padding="12,8" CornerRadius="12" MaxWidth="640">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource AssistantBubbleBrush}"/>
                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Role}" Value="user">
                                                <Setter Property="Background" Value="{DynamicResource UserBubbleBrush}"/>
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontSize="14"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
